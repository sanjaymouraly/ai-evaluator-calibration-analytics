# ---------------------------------------------------------------------------
# AI Evaluator Calibration & Disagreement Analytics — environment template
#
# Copy to .env and adjust. NEVER commit .env or real secrets.
#   cp .env.example .env
#
# For local development WITHOUT Docker you can skip everything except
# JWT_SECRET_KEY (SQLite is used by default).
# ---------------------------------------------------------------------------

# --- Application ---
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# --- Database ---
# SQLite (default, zero-config local development):
DATABASE_URL=sqlite:///./eval_platform.db
# PostgreSQL (production / docker-compose):
# DATABASE_URL=postgresql+psycopg2://evalplatform:change-me@localhost:5432/evalplatform

# --- Auth / JWT ---
# REQUIRED. Generate with:  openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=14
# OWASP-recommended PBKDF2-SHA256 work factor
PASSWORD_HASH_ITERATIONS=600000

# --- Security ---
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_MB=25

# --- Reports ---
REPORTS_DIR=./reports

# ---------------------------------------------------------------------------
# Optional AI assistance (the platform is fully functional WITHOUT any of this)
# ---------------------------------------------------------------------------
# Master switch. Must be explicitly true to allow live provider calls.
LLM_ENABLED=false
# openai | anthropic | openrouter | openai_compatible | ollama | (empty = offline)
LLM_PROVIDER=
# Leave blank to use each provider's default endpoint.
LLM_BASE_URL=
LLM_MODEL=
# Prefer environment delivery; keys are encrypted at rest when saved via the UI.
LLM_API_KEY=
# Explicit consent gate: evaluation content (prompts/responses/rationales) is
# only sent to a provider when this is true.
LLM_ALLOW_EVALUATION_CONTENT=false
# Guardrails
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=30
LLM_MAX_REQUESTS_PER_MINUTE=20
LLM_MAX_COST_USD=5.0

# --- docker-compose / PostgreSQL ---
POSTGRES_USER=evalplatform
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=evalplatform
